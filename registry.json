        "button",
        "checkbox",
        "command",
        "label",
        "popover",
        "scroll-area"
      ],
      "files": [
        { "path": "src/components/combobox/combobox.tsx", "type": "registry:ui", "target": "@ui/combobox/combobox.tsx" },
        { "path": "src/components/combobox/popover.tsx", "type": "registry:ui", "target": "@ui/combobox/popover.tsx" },
        { "path": "src/components/combobox/types.ts", "type": "registry:ui", "target": "@ui/combobox/types.ts" },
        { "path": "src/components/combobox/utils.ts", "type": "registry:ui", "target": "@ui/combobox/utils.ts" },
        { "path": "src/components/combobox/defaults.ts", "type": "registry:ui", "target": "@ui/combobox/defaults.ts" },
        { "path": "src/components/combobox/remote.ts", "type": "registry:ui", "target": "@ui/combobox/remote.ts" },
        { "path": "docs/combobox.md", "type": "registry:file", "target": "@ui/combobox/combobox.md" }
      ]
    }
  ]
