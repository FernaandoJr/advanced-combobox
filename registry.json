{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "advanced-combobox",
  "homepage": "https://github.com/FernaandoJr/advanced-combobox",
  "items": [
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "combobox",
      "type": "registry:ui",
